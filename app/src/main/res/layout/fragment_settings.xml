<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingBottom="@dimen/screen_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/nav_settings"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp"
            android:text="@string/settings_cycle"
            android:textAppearance="@style/TextAppearance.CycleTracker.Section" />

        <include
            android:id="@+id/row_cycle_length"
            layout="@layout/row_setting" />

        <include
            android:id="@+id/row_period_length"
            layout="@layout/row_setting" />

        <include
            android:id="@+id/row_luteal_length"
            layout="@layout/row_setting" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_cycle_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp"
            android:text="@string/settings_notifications"
            android:textAppearance="@style/TextAppearance.CycleTracker.Section" />

        <include
            android:id="@+id/sw_phase_alerts"
            layout="@layout/row_switch" />

        <include
            android:id="@+id/sw_period_alerts"
            layout="@layout/row_switch" />

        <include
            android:id="@+id/sw_discreet"
            layout="@layout/row_switch" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp"
            android:text="@string/settings_security"
            android:textAppearance="@style/TextAppearance.CycleTracker.Section" />

        <include
            android:id="@+id/sw_app_lock"
            layout="@layout/row_switch" />

        <include
            android:id="@+id/sw_block_screenshots"
            layout="@layout/row_switch" />

        <include
            android:id="@+id/row_privacy"
            layout="@layout/row_setting" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp"
            android:text="@string/settings_backup"
            android:textAppearance="@style/TextAppearance.CycleTracker.Section" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/settings_backup_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/drive_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            app:drawableStartCompat="@drawable/ic_cloud"
            app:drawableTint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/last_backup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/last_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_drive"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_drive_connect" />

        <include
            android:id="@+id/row_passphrase"
            layout="@layout/row_setting" />

        <include
            android:id="@+id/sw_auto_backup"
            layout="@layout/row_switch" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_backup_now"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_backup_now" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_restore_drive"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_restore_drive" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_export"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_export" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_import"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_import" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp"
            android:text="@string/settings_data"
            android:textAppearance="@style/TextAppearance.CycleTracker.Section" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_all"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_delete_all"
            android:textColor="?attr/colorError"
            app:strokeColor="?attr/colorError" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp"
            android:text="@string/settings_about"
            android:textAppearance="@style/TextAppearance.CycleTracker.Section" />

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="24dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
