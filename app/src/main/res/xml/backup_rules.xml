<?xml version="1.0" encoding="utf-8"?>
<!-- Privacidad: se excluye todo del respaldo automático de Android (API < 31).
     Los respaldos se hacen solo de forma explícita y cifrada por la propia app. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
